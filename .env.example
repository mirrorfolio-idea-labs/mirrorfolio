# Environment Variables
# Copy this file to .env and fill in your actual values

# ===========================================
# RAZORPAY CONFIGURATION
# ===========================================
# Get your keys from https://dashboard.razorpay.com/app/keys

# Test mode keys (use these for development)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Production keys (use these for live payments)
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# DATABASE CONFIGURATION (NeonDB PostgreSQL)
# ===========================================
# Get your connection string from https://neon.tech
DATABASE_URL=postgresql://username:password@hostname/database?sslmode=require

# ===========================================
# EMAIL CONFIGURATION (SMTP)
# ===========================================
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
# For other providers: Use your SMTP credentials

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com